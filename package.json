{
	"name": "obsidian-nutstore-sync",
	"version": "1.5.0",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "run-s lint build:plugin",
		"build:plugin": "node esbuild.config.mjs production && swc ./dist/main.js -o main.js",
		"lint": "run-p lint:eslint lint:tsc lint:deps",
		"lint:deps": "pnpm audit --audit-level=low",
		"lint:eslint": "eslint . --max-warnings=0",
		"lint:tsc": "tsc -noEmit -skipLibCheck",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "run-p test:unit test:obsidian",
		"test:unit": "vitest --run",
		"test:models-api": "jiti scripts/update-models-api.ts --check",
		"test:obsidian": "node scripts/run-obsidian-integration.mjs",
		"update:models-api": "jiti scripts/update-models-api.ts",
		"postinstall": "lefthook install"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.49",
		"@ai-sdk/google": "^4.0.64",
		"@ai-sdk/openai": "^4.0.60",
		"@ai-sdk/openai-compatible": "^3.0.44",
		"@codemirror/state": "6.5.2",
		"@codemirror/view": "6.36.4",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@nutstore/sso-js": "^0.0.9",
		"@solid-primitives/i18n": "^2.2.1",
		"@tanstack/solid-table": "^8.21.3",
		"@tanstack/solid-virtual": "^3.13.37",
		"ai": "^7.0.93",
		"assert": "^2.1.0",
		"async-mutex": "^0.5.0",
		"blob-polyfill": "^9.0.20240710",
		"bottleneck": "^2.19.5",
		"buffer": "^6.0.3",
		"bytes-iec": "^3.1.1",
		"consola": "^3.4.2",
		"core-js": "^3.50.0",
		"diff-match-patch": "^1.0.5",
		"es-toolkit": "^1.52.0",
		"fast-xml-parser": "^5.11.1",
		"fflate": "^0.8.3",
		"html-entities": "^2.6.0",
		"http-status-codes": "^2.3.0",
		"i18next": "^24.2.3",
		"id-agent": "^1.1.5",
		"js-base64": "^3.9.3",
		"just-bash": "^3.4.2",
		"localforage": "^1.10.0",
		"node-diff3": "^3.2.1",
		"ohash": "^1.1.6",
		"path-browserify": "^1.0.1",
		"rxjs": "^7.8.2",
		"solid-js": "^1.9.15",
		"stream-browserify": "^3.0.0",
		"superjson": "^2.2.6",
		"uuid": "^13.0.2",
		"webdav": "^5.10.0",
		"yjs": "^13.6.32",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/css": "^1.4.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^1.2.0",
		"@eslint/markdown": "^8.0.3",
		"@gfx/zopfli": "1.0.15",
		"@iconify-json/lucide": "^1.2.129",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.16.2",
		"@types/diff-match-patch": "^1.0.36",
		"@types/node": "^16.18.126",
		"@types/path-browserify": "^1.0.3",
		"@vitest/coverage-v8": "^3.2.7",
		"baseline-browser-mapping": "^2.11.21",
		"esbuild": "^0.25.12",
		"esbuild-sass-plugin": "^3.7.0",
		"eslint": "^10.10.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"eslint-plugin-solid": "^0.14.5",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.12.0",
		"jiti": "^2.7.0",
		"lefthook": "^2.1.12",
		"microsandbox": "0.6.16",
		"npm-run-all2": "^7.0.2",
		"obsidian": "latest",
		"postcss": "^8.5.28",
		"postcss-merge-rules": "^7.0.11",
		"prettier": "^3.9.6",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0",
		"unocss": "66.1.0-beta.3",
		"unplugin-solid": "^1.0.0",
		"vitest": "^3.2.7"
	},
	"browser": {
		"path": "path-browserify",
		"stream": "stream-browserify",
		"buffer": "buffer"
	}
