{
	"name": "obsidian-nutstore-sync",
	"version": "1.4.2",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "run-s lint build:plugin",
		"build:plugin": "node esbuild.config.mjs production && swc ./dist/main.js -o main.js",
		"lint": "run-p lint:eslint lint:tsc",
		"lint:eslint": "eslint . --max-warnings=0",
		"lint:tsc": "tsc -noEmit -skipLibCheck",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "run-p test:unit test:obsidian",
		"test:unit": "vitest --run",
		"test:models-api": "jiti scripts/update-models-api.ts --check",
		"test:obsidian": "node scripts/run-obsidian-integration.mjs",
		"update:models-api": "jiti scripts/update-models-api.ts",
		"postinstall": "lefthook install"
	},
